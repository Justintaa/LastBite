 ).split(",")
 
+# CSRF_TRUSTED_ORIGINS needs full scheme+host, e.g. https://lastbite.onrender.com
+CSRF_TRUSTED_ORIGINS = [
+    origin.strip() for origin in os.getenv("DJANGO_CSRF_TRUSTED_ORIGINS", "").split(",") if origin.strip()
